{
  "ConnectionStrings": {
    "DraftDatastore": "Server=(localdb)\\MSSQLLocalDB;Database=DraftDatastore;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "DraftDatastore",
    "Audience": "DraftDatastore.Client",
    "SigningKey": "replace-with-a-secure-32-character-minimum-key",
    "AccessTokenLifetimeMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "OpenAI": {
    "Enabled": true,
    "Model": "gpt-4.1-mini"
  },
  "BlobStorage": {
    "ConnectionString": "set-as-an-Azure-App-Service-Key-Vault-reference",
    "PlayerImagesContainer": "player-images"
  }
}
